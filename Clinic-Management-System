#include <iostream>
#include <vector>
#include <string>
#include <fstream>
#include <sstream>
#include <iomanip> // للتنسيق الاحترافي للجداول

using namespace std;

// ألوان الـ ANSI للواجهة الاحترافية
#define RESET   "\033[0m"
#define RED     "\033[31m"
#define GREEN   "\033[32m"
#define YELLOW  "\033[33m"
#define BLUE    "\033[34m"
#define CYAN    "\033[36m"
#define BOLD    "\033[1m"

// هيكل بيانات المريض
struct Patient {
    int id;
    string name;
    int age;
    string phone;
};

// هيكل بيانات الموعد الطبي
struct Appointment {
    int id;
    int patientId;
    string date;
    string time;
    string doctor;
    string status; // Scheduled, Completed, Cancelled
};

class ClinicManager {
private:
    vector<Patient> patients;
    vector<Appointment> appointments;
    int nextPatientId = 1;
    int nextAppointmentId = 1;

    const string PATIENTS_FILE = "patients.txt";
    const string APPOINTMENTS_FILE = "appointments.txt";

    // --- حفظ البيانات في الملفات ---
    void saveData() {
        ofstream pFile(PATIENTS_FILE);
        for (const auto& p : patients) {
            pFile << p.id << "," << p.name << "," << p.age << "," << p.phone << "\n";
        }
        pFile.close();

        ofstream aFile(APPOINTMENTS_FILE);
        for (const auto& app : appointments) {
            aFile << app.id << "," << app.patientId << "," << app.date << "," << app.time << "," << app.doctor << "," << app.status << "\n";
        }
        aFile.close();
    }

    // --- تحميل البيانات من الملفات عند تشغيل البرنامج ---
    void loadData() {
        patients.clear();
        appointments.clear();

        ifstream pFile(PATIENTS_FILE);
        if (pFile.is_open()) {
            string line;
            while (getline(pFile, line)) {
                if (line.empty()) continue;
                stringstream ss(line);
                string idStr, ageStr;
                Patient p;
                getline(ss, idStr, ',');
                getline(ss, p.name, ',');
                getline(ss, ageStr, ',');
                getline(ss, p.phone, ',');

                p.id = stoi(idStr);
                p.age = stoi(ageStr);
                patients.push_back(p);
                if (p.id >= nextPatientId) nextPatientId = p.id + 1;
            }
            pFile.close();
        }

        ifstream aFile(APPOINTMENTS_FILE);
        if (aFile.is_open()) {
            string line;
            while (getline(aFile, line)) {
                if (line.empty()) continue;
                stringstream ss(line);
                string idStr, pIdStr;
                Appointment app;
                getline(ss, idStr, ',');
                getline(ss, pIdStr, ',');
                getline(ss, app.date, ',');
                getline(ss, app.time, ',');
                getline(ss, app.doctor, ',');
                getline(ss, app.status, ',');

                app.id = stoi(idStr);
                app.patientId = stoi(pIdStr);
                appointments.push_back(app);
                if (app.id >= nextAppointmentId) nextAppointmentId = app.id + 1;
            }
            aFile.close();
        }
    }

public:
    ClinicManager() {
        loadData();
    }

    // 1. إضافة مريض جديد
    void addPatient() {
        Patient p;
        p.id = nextPatientId++;
        cout << CYAN << "\n=== إضافة مريض جديد ===" << RESET << endl;
        cout << "اسم المريض: ";
        cin.ignore();
        getline(cin, p.name);
        cout << "العمر: ";
        cin >> p.age;
        cout << "رقم الهاتف: ";
        cin >> p.phone;

        patients.push_back(p);
        saveData();
        cout << GREEN << "✅ تم تسجيل المريض بنجاح برقم تعريف (ID): " << p.id << RESET << endl;
    }

    // 2. عرض كافة المرضى في جدول منظم
    void viewPatients() {
        if (patients.empty()) {
            cout << YELLOW << "\n👥 لا يوجد مرضى مسجلين حالياً." << RESET << endl;
            return;
        }
        cout << CYAN << BOLD << "\n================================ قائمة المرضى ================================" << RESET << endl;
        cout << left << setw(8) << "ID" << setw(25) << "Name" << setw(10) << "Age" << setw(18) << "Phone" << endl;
        cout << "-----------------------------------------------------------------------------" << endl;
        for (const auto& p : patients) {
            cout << left << setw(8) << p.id << setw(25) << p.name << setw(10) << p.age << setw(18) << p.phone << endl;
        }
        cout << CYAN << "=============================================================================\n" << RESET << endl;
    }

    // 3. البحث عن مريض بالاسم، الـ ID أو الهاتف
    void searchPatient() {
        if (patients.empty()) {
            cout << YELLOW << "\n👥 لا يوجد مرضى مسجلين." << RESET << endl;
            return;
        }
        cout << CYAN << "\n=== البحث عن مريض ===" << RESET << endl;
        cout << "أدخل الاسم أو رقم الـ ID أو الهاتف: ";
        string query;
        cin.ignore();
        getline(cin, query);

        bool found = false;
        cout << left << setw(8) << "ID" << setw(25) << "Name" << setw(10) << "Age" << setw(18) << "Phone" << endl;
        cout << "-----------------------------------------------------------------------------" << endl;
        for (const auto& p : patients) {
            if (to_string(p.id) == query || p.name.find(query) != string::npos || p.phone.find(query) != string::npos) {
                cout << left << setw(8) << p.id << setw(25) << p.name << setw(10) << p.age << setw(18) << p.phone << endl;
                found = true;
            }
        }
        if (!found) cout << RED << "❌ لم يتم العثور على نتائج طابقت البحث." << RESET << endl;
    }

    // 4. تعديل بيانات مريض
    void editPatient() {
        int id;
        cout << "\nأدخل رقم تعريف المريض المراد تعديله: ";
        cin >> id;

        for (auto& p : patients) {
            if (p.id == id) {
                cout << "الاسم الحالي (" << p.name << ") - الاسم الجديد: ";
                cin.ignore();
                getline(cin, p.name);
                cout << "العمر الحالي (" << p.age << ") - العمر الجديد: ";
                cin >> p.age;
                cout << "رقم الهاتف الحالي (" << p.phone << ") - الرقم الجديد: ";
                cin >> p.phone;

                saveData();
                cout << GREEN << "✅ تم تعديل بيانات المريض بنجاح." << RESET << endl;
                return;
            }
        }
        cout << RED << "❌ لم يتم العثور على مريض بهذا الرقم." << RESET << endl;
    }

    // 5. حذف مريض وحذف مواعيده تلقائياً (Cascade Delete)
    void deletePatient() {
        int id;
        cout << "\nأدخل رقم تعريف المريض المراد حذفه: ";
        cin >> id;

        bool found = false;
        for (auto it = patients.begin(); it != patients.end(); ++it) {
            if (it->id == id) {
                patients.erase(it);
                found = true;
                break;
            }
        }

        if (found) {
            for (auto it = appointments.begin(); it != appointments.end(); ) {
                if (it->patientId == id) {
                    it = appointments.erase(it);
                } else {
                    ++it;
                }
            }
            saveData();
            cout << GREEN << "✅ تم حذف المريض وكافة مواعيده بنجاح." << RESET << endl;
        } else {
            cout << RED << "❌ لم يتم العثور على مريض بهذا الرقم." << RESET << endl;
        }
    }

    // 6. حجز موعد طبي جديد
    void bookAppointment() {
        if (patients.empty()) {
            cout << YELLOW << "⚠️ لا يوجد مرضى مسجلين بالنظام حالياً." << RESET << endl;
            return;
        }

        Appointment app;
        app.id = nextAppointmentId++;

        cout << CYAN << "\n=== حجز موعد طبي ===" << RESET << endl;
        cout << "أدخل رقم تعريف المريض (Patient ID): ";
        cin >> app.patientId;

        bool found = false;
        for (const auto& p : patients) {
            if (p.id == app.patientId) {
                found = true;
                break;
            }
        }

        if (!found) {
            cout << RED << "❌ لم يتم العثور على مريض بهذا الرقم." << RESET << endl;
            return;
        }

        cout << "تاريخ الموعد (YYYY-MM-DD): ";
        cin >> app.date;
        cout << "وقت الموعد (HH:MM): ";
        cin >> app.time;
        cout << "اسم الطبيب المعالج: ";
        cin.ignore();
        getline(cin, app.doctor);
        app.status = "Scheduled";

        appointments.push_back(app);
        saveData();
        cout << GREEN << "📅 تم حجز الموعد بنجاح. رقم الموعد: " << app.id << RESET << endl;
    }

    // 7. عرض جدول المواعيد
    void viewAppointments() {
        if (appointments.empty()) {
            cout << YELLOW << "\n📅 جدول المواعيد فارغ حالياً." << RESET << endl;
            return;
        }

        cout << CYAN << BOLD << "\n=================================== جدول المواعيد ===================================" << RESET << endl;
        cout << left << setw(8) << "App ID" << setw(20) << "Patient Name" << setw(14) << "Date" << setw(10) << "Time" << setw(20) << "Doctor" << setw(12) << "Status" << endl;
        cout << "----------------------------------------------------------------------------------------------------" << endl;
        for (const auto& app : appointments) {
            string patientName = "Unknown";
            for (const auto& p : patients) {
                if (p.id == app.patientId) {
                    patientName = p.name;
                    break;
                }
            }
            cout << left << setw(8) << app.id << setw(20) << patientName << setw(14) << app.date << setw(10) << app.time << setw(20) << app.doctor << setw(12) << app.status << endl;
        }
        cout << CYAN << "====================================================================================================\n" << RESET << endl;
    }

    // 8. تعديل حالة موعد (مكتمل / ملغي / مجدول)
    void updateAppointmentStatus() {
        int id;
        cout << "\nأدخل رقم الموعد المراد تعديل حالته: ";
        cin >> id;

        for (auto& app : appointments) {
            if (app.id == id) {
                cout << "اختر الحالة الجديدة:\n1. مكتمل (Completed)\n2. ملغي (Cancelled)\n3. مجدول (Scheduled)\nالخيار: ";
                int statusChoice;
                cin >> statusChoice;
                if (statusChoice == 1) app.status = "Completed";
                else if (statusChoice == 2) app.status = "Cancelled";
                else app.status = "Scheduled";

                saveData();
                cout << GREEN << "✅ تم تحديث حالة الموعد بنجاح." << RESET << endl;
                return;
            }
        }
        cout << RED << "❌ لم يتم العثور على موعد بهذا الرقم." << RESET << endl;
    }

    // 9. عرض السجل الطبي لمريض محدد
    void viewPatientHistory() {
        int id;
        cout << "\nأدخل رقم تعريف المريض لعرض السجل: ";
        cin >> id;

        string patientName = "";
        for (const auto& p : patients) {
            if (p.id == id) {
                patientName = p.name;
                break;
            }
        }

        if (patientName.empty()) {
            cout << RED << "❌ لم يتم العثور على مريض بهذا الرقم." << RESET << endl;
            return;
        }

        cout << CYAN << BOLD << "\n=== السجل الطبي للمريض: " << patientName << " ===" << RESET << endl;
        bool hasAppointments = false;
        cout << left << setw(8) << "App ID" << setw(14) << "Date" << setw(10) << "Time" << setw(20) << "Doctor" << setw(12) << "Status" << endl;
        cout << "------------------------------------------------------------------" << endl;
        for (const auto& app : appointments) {
            if (app.patientId == id) {
                cout << left << setw(8) << app.id << setw(14) << app.date << setw(10) << app.time << setw(20) << app.doctor << setw(12) << app.status << endl;
                hasAppointments = true;
            }
        }
        if (!hasAppointments) cout << YELLOW << "لا توجد مواعيد مسجلة لهذا المريض." << RESET << endl;
    }
};

int main() {
    setlocale(LC_ALL, "Arabic");
    ClinicManager clinic;
    int choice;

    do {
        cout << BLUE << BOLD << "\n--------------------------------------------" << RESET << endl;
        cout << BLUE << BOLD << " 🏥 نظام إدارة العيادة الطبية (v3.0 Ultra)" << RESET << endl;
        cout << BLUE << BOLD << "--------------------------------------------" << RESET << endl;
        cout << "1.  إضافة مريض جديد\n";
        cout << "2.  عرض قائمة المرضى\n";
        cout << "3.  البحث عن مريض\n";
        cout << "4.  تعديل بيانات مريض\n";
        cout << "5.  حذف مريض\n";
        cout << "6.  حجز موعد طبي\n";
        cout << "7.  عرض جدول المواعيد\n";
        cout << "8.  تعديل حالة موعد\n";
        cout << "9.  عرض السجل الطبي لمريض\n";
        cout << "10. خروج من البرنامج\n";
        cout << BOLD << "اختر عملية (1-10): " << RESET;

        if (!(cin >> choice)) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << RED << "⚠️ إدخال خاطئ! يرجى كتابة رقم من 1 إلى 10." << RESET << endl;
            continue;
        }

        switch (choice) {
            case 1: clinic.addPatient(); break;
            case 2: clinic.viewPatients(); break;
            case 3: clinic.searchPatient(); break;
            case 4: clinic.editPatient(); break;
            case 5: clinic.deletePatient(); break;
            case 6: clinic.bookAppointment(); break;
            case 7: clinic.viewAppointments(); break;
            case 8: clinic.updateAppointmentStatus(); break;
            case 9: clinic.viewPatientHistory(); break;
            case 10: cout << GREEN << "👋 تم إغلاق النظام وحفظ البيانات تلقائياً." << RESET << endl; break;
            default: cout << RED << "⚠️ خيار غير صحيح، حاول مجدداً." << RESET << endl;
        }
    } while (choice != 10);

    return 0;
}
